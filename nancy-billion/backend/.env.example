# Backend configuration
HOST=0.0.0.0
PORT=8000
WS_PATH=/ws

# Comma-separated origins the browser is allowed to call this API from.
# Must match the frontend's actual dev port -- this project runs
# `next dev -p 3005`, not Next's default 3000.
NANCY_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# STT
STT_BACKEND=faster_whisper   # options: faster_whisper, openai_whisper, mlx
WHISPER_MODEL=tiny.en        # or small, medium, large
WHISPER_DEVICE=cpu           # cuda, cpu, or mlx (for Apple Silicon)

# LLM
# get_llm_backends() in llm.py builds the real priority order: cloud backends
# first (best quality, in the order below), then local Ollama as an offline
# fallback, then Fury, then llama.cpp (if LLM_MODEL_PATH is a real file), then
# vLLM (if VLLM_BASE_URL is set). LLM_BACKENDS below only affects a legacy
# secondary list (dummy/llama_cpp/ollama) appended after that -- not the main
# ordering, and llama_cpp there is redundant with the automatic check above.
LLM_BACKENDS=dummy,ollama,anthropic,openai,gemini,openrouter,groq

# llama.cpp -- real fully-offline local inference, no API key, no per-token
# cost. Comma-separated list of real .gguf file paths, tried in order (so a
# second entry is a real fallback if the first fails to load/generate) --
# any entry that isn't a real file is skipped. Leave unset to skip llama.cpp
# entirely. deepreinforce-ai/Ornith-1.0-9B-GGUF (agentic-coding-specialized,
# MIT licensed) and microsoft/Phi-3-mini-4k-instruct-gguf (general-purpose,
# smaller/faster) are both good picks; download the Q4_K_M quant from
# Hugging Face and point this at it/them.
LLM_MODEL_PATH=
LLM_N_CTX=4096
LLM_N_BATCH=512
LLM_N_GPU_LAYERS=0           # set >0 for GPU acceleration if supported

# vLLM -- real self-hosted, GPU-backed high-throughput serving. Nancy never
# starts this itself (`python -m vllm.entrypoints.openai.api_server
# --model ... --port 8001`); set VLLM_BASE_URL to point at wherever your own
# vLLM server is already running. Leave unset to skip entirely.
VLLM_BASE_URL=
VLLM_MODEL=

# Ollama (free, local, offline fallback -- install from ollama.com, then
# `ollama pull llama3.2:3b` or similar; pick a small model on CPU-only hardware).
# Ollama auto-discovers and tries EVERY locally installed model in turn
# (OllamaAutoModelsLLM), so pulling several is fine, not wasteful.
# Running this backend natively: http://localhost:11434 is correct.
# Running via `docker compose` (this project's real deployment): Ollama runs
# on the HOST, not inside the backend container, so "localhost" here means
# the container's own loopback and silently can't reach it -- confirmed
# live this session, this was broken and unnoticed for a while. Use
# http://host.docker.internal:11434 instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Coding-task fallback model (see select_llm_for_task) -- `ollama pull qwen2.5-coder:3b`
OLLAMA_CODING_MODEL=qwen2.5-coder:3b

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Gemini (Google) -- check https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
# for currently-supported model ids; "gemini-pro" alone was retired.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-latest

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Groq -- check https://console.groq.com/docs/deprecations for currently-supported models.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenCode Zen (coding-focused model gateway, https://opencode.ai/zen) -- sign
# in at opencode.ai, add billing, copy your API key here. Model ids are bare
# (e.g. "big-pickle", "gpt-5.5") -- confirm against GET /v1/models.
OPENCODE_API_KEY=
OPENCODE_MODEL=big-pickle

# TTS
# options: neutts (real local neural voice via fury-sdk's NeuTTS-nano, CPU-only,
#   see neu_tts.py — default), pyttsx3 (Windows SAPI, robotic, kept as a fallback)
TTS_BACKEND=neutts
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
TTS_SPEAKER=
TTS_LANGUAGE=en
TTS_USE_CUDA=False

# NeuTTS voice-cloning reference clip. Checked in this order:
#   1. voice_ref/user_reference.wav + user_reference.txt  <- drop your own clip + its transcript here, then restart the backend
#   2. voice_ref/synthetic_reference.wav + .txt            <- auto-bootstrapped via the Pyttsx3 "Hazel" voice if neither exists
VOICE_REF_DIR=./voice_ref
# phonemizer (a NeuTTS dependency) needs the espeak-ng system library on PATH.
# On Windows: winget install eSpeak-NG.eSpeak-NG (or the official installer),
# then point these at its install dir if it isn't auto-detected:
# PHONEMIZER_ESPEAK_LIBRARY=C:\Program Files\eSpeak NG\libespeak-ng.dll
# PHONEMIZER_ESPEAK_PATH=C:\Program Files\eSpeak NG\espeak-ng.exe

# PersonaPlex (optional)
PERSONAPLEX_ENABLED=False
PERSONAPLEX_MODEL=nvidia/personaplex-7b-v1
PERSONAPLEX_VOICE_PROMPT=assets/voice_prompt.pt   # path to .pt embedding
PERSONAPLEX_DEVICE=cpu

# Open Generative AI (tool)
OPENAI_GENERATIVE_API_URL=http://localhost:3000/api/generate   # if using local OGAI service
OPENAI_GENERATIVE_API_KEY=

# MiroFish (tool)
MIROFISH_API_URL=http://localhost:5001/api
MIROFISH_API_KEY=

# Memory
MEMORY_DB_PATH=./data/memory.sqlite

# Telegram (remote notifications/approvals -- see telegram_bot.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Proactive daily briefing pushed to Telegram automatically, no request
# needed -- 24h local time (see _daily_briefing_loop in main_new.py)
DAILY_BRIEFING_HOUR=7
DAILY_BRIEFING_MINUTE=30

# FRED (St. Louis Fed) -- powers live NFP/CPI/FOMC tracking
# (economic_calendar.py). Free, instant self-serve key:
# https://fred.stlouisfed.org/docs/api/api_key.html
# (Financial Modeling Prep was tried first, but its economic-calendar
# endpoint turned out to require a paid plan once tested against a real
# account -- confirmed via direct probe, not assumed. FRED has real actual
# release dates/values for NFP+CPI and no rate-limit concern at this
# polling cadence, but no consensus/forecast data -- estimate is always
# null.) Without this set, the economic calendar feature is silently
# disabled (logs a warning once, /economic-calendar/events returns an
# empty list, "configured": false).
FRED_API_KEY=

# --- Secrets broker (secrets_broker.py) -- optional, only needed if you use
# bw://, op://, or vault:// references instead of plain env vars elsewhere ---
BW_SESSION=
OP_SERVICE_ACCOUNT_TOKEN=
VAULT_ADDR=
VAULT_TOKEN=

# --- Provider registries (providers/registry.py) -- each vendor is fully
# optional; an unconfigured one is just never registered, same graceful
# degrade as every LLM provider key above. Set <CAPABILITY>_PROVIDER_ORDER
# (e.g. WEB_SEARCH_PROVIDER_ORDER=brave,tavily) to control priority when more
# than one vendor for the same capability is configured. ---
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_BASE_URL=
FAL_API_KEY=
DEEPINFRA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEEPGRAM_API_KEY=

# Spotify (providers/spotify_tool.py) -- one-time manual OAuth: create an app
# at https://developer.spotify.com/dashboard, then run the standard
# authorization-code flow once (scope: user-modify-playback-state,
# user-read-playback-state) to obtain a refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Google Calendar (providers/google_calendar.py) -- one-time manual OAuth:
# create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type "Desktop app"), enable the Google Calendar API for the project, then
# run the standard authorization-code flow once (scope:
# https://www.googleapis.com/auth/calendar) to obtain a refresh token, e.g.
# via https://developers.google.com/oauthplayground (use your own client
# ID/secret under the gear icon so the resulting refresh token doesn't expire).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ClawRouter (llm.py's get_llm_backends()) -- managed multi-provider LLM routing.
CLAWROUTER_API_KEY=
CLAWROUTER_MODEL=auto

# --- External memory providers (memory/providers/*.py) -- additional hosted
# memory backends, each fully optional and independent of Nancy's default
# local MemoryGraph/LanceDB. ---
MEM0_API_KEY=
SUPERMEMORY_API_KEY=
HONCHO_API_KEY=
HINDSIGHT_API_KEY=
BYTEROVER_API_KEY=
OPENVIKING_API_KEY=
RETAINDB_API_KEY=

# Real local alternative to MemoryGraph's brute-force in-memory cosine scan --
# set to "lancedb" to use memory/lancedb_store.py's embedded ANN index
# instead. Defaults to "graph" (today's behavior) if unset or if lancedb
# isn't installed.
MEMORY_BACKEND=graph

# Debug report sharing (debug_share.py) -- optional. Without these, /debug/share
# just saves the redacted zip locally under backend/backups/ instead of
# uploading it anywhere.
DEBUG_SHARE_ENDPOINT=
DEBUG_SHARE_API_KEY=

# Paired-node remote exec (node_host.py / approval_policy.py / node_agent_stub.py).
# This var is read by node_agent_stub.py itself when run ON the second/paired
# machine (`python node_agent_stub.py`) -- NOT by this backend. This backend
# stores each node's shared secret via POST /nodes instead.
NODE_SHARED_SECRET=
NODE_AGENT_PORT=8100

# Egress proxy (egress_proxy.py / coverage_proxy.py) -- real local
# TLS-intercepting default-deny outbound firewall. Empty EGRESS_ALLOWED_HOSTS
# means nothing is allowed through once the proxy is running (default-deny) --
# add real hostnames as you need them, comma-separated.
EGRESS_PROXY_PORT=8899
EGRESS_ALLOWED_HOSTS=

# Real phone calls (providers/telephony/twilio.py, channels/voice_call.py).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VOICE_CALL_DEFAULT_TO=

# Realtime "Talk" voice mode (realtime_voice.py) -- an opt-in, lower-latency
# alternative to the default local-Whisper wake-word detector, streaming mic
# audio to Deepgram's real-time API (same DEEPGRAM_API_KEY as the batch
# transcription provider above) instead of polling a local rolling buffer.
WAKE_WORD_BACKEND=

# --- Channels (channels/registry.py) -- each is fully optional; an
# unconfigured channel is just never offered/registered, same graceful
# degrade as every LLM provider key above ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_NOTIFY_SERVICE=notify.notify

PHOTON_SIDECAR_URL=
PHOTON_SHARED_SECRET=
PHOTON_DEFAULT_RECIPIENT=

REEF_API_KEY=
REEF_ENDPOINT=
REEF_PEER_ID=
REEF_ENCRYPTION_KEY=

CLICKCLACK_API_KEY=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=

# Discord (channels/discord.py) -- create a bot at discord.com/developers/
# applications, invite it to your server with "Send Messages" permission,
# then copy the target channel's ID (enable Developer Mode in Discord to
# right-click → Copy Channel ID).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# WhatsApp (channels/whatsapp.py) -- Meta's WhatsApp Business Cloud API.
# Create an app at developers.facebook.com, add the WhatsApp product; the
# dev dashboard gives you a test phone_number_id + temporary access token.
# WHATSAPP_DEFAULT_TO is the recipient's number in international format
# (no +, e.g. "15551234567") -- free-form messages only deliver within 24h
# of the recipient having messaged your WhatsApp number first.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_TO=

# --- Batch 10: remaining infra ---
# Crabbox remote sandboxed execution (providers/sandbox/crabbox.py).
CRABBOX_API_KEY=
CRABBOX_ENDPOINT=

# Docker-backed multi-tenant sandbox cells (fleet/*.py) -- requires Docker
# Desktop (or another Docker Engine) actually running on this machine. Leave
# blank to use the local default socket/named pipe.
DOCKER_HOST=

# Logging
LOG_LEVEL=INFO