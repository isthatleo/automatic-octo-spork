# Nancy/Billion Frontend — Environment Configuration

# Backend URL (where Nancy/Billion backend is running). Server-only --
# do NOT rename this to NEXT_PUBLIC_BACKEND_URL. The browser is meant to
# talk to the same-origin authenticated proxy (/api/backend/*, see
# app/api/backend/[...path]/route.ts) which attaches BACKEND_AUTH_TOKEN
# server-side; every client-side call falls back to that proxy only
# when NEXT_PUBLIC_BACKEND_URL is unset. Setting the NEXT_PUBLIC_
# variant instead bakes this raw URL into the browser bundle, so those
# calls skip the proxy (and its auth header) entirely -- confirmed live
# as silent 401s on things like the Agents panel.
BACKEND_URL=http://localhost:8000

# Must match the backend's own BACKEND_AUTH_TOKEN (nancy-billion/backend/.env)
# exactly. Server-side only -- lib/nancy/backend-server.ts holds this and
# attaches it to every /api/backend/* proxy call; it never reaches the browser.
BACKEND_AUTH_TOKEN=

# Gates the whole control room behind a passcode (see middleware.ts).
BILLION_PASSCODE=
# Optional: signs the session cookie. Left unset -- derived from the
# passcode above, so changing the passcode invalidates existing sessions.
BILLION_SESSION_SECRET=

# Vercel Analytics (optional)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Future: Add other frontend configuration as needed

