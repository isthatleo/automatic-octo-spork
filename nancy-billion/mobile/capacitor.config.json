{
  "appId": "os.sovereign.billion",
  "appName": "Billion",
  "webDir": "www",
  "backgroundColor": "#05080e",
  "server": {
    "cleartext": true,
    "androidScheme": "http",
    "allowNavigation": ["*"]
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#05080e",
      "showSpinner": false
    }
  }
}
