{
  "name": "nancy-billion",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "health": "curl -s http://localhost:8000/health",
    "cli": "python cli/billion.py",
    "test": "python backend/test_tool_backend_order.py",
    "icons": "python scripts/gen_icons.py",
    "app:desktop": "cd desktop && npm install --no-audit --no-fund && npm start",
    "app:build": "bash scripts/build-apps.sh desktop",
    "app:android": "bash scripts/build-apps.sh android",
    "app:ios": "bash scripts/build-apps.sh ios",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn main_new:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd backend && pip install -r requirements.txt && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
