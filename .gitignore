# Never commit real environment files anywhere in this repo, including
# node_modules mirrors and backup/snapshot directories -- they've leaked
# real-looking API keys/DB passwords more than once. .env.example and
# similar template files are unaffected (different filename).
**/.env

# Vendored/generated content -- never belongs in git history. A stray
# compiled binary under node_modules once exceeded GitHub's 100MB file
# limit and blocked every push until history was rewritten to remove it.
**/node_modules/
**/__pycache__/
*.pyc
**/.next/
*.log

# Staging area for files Claude moved out of the tree (delete at leisure --
# the sandbox cannot delete files on this machine, only move them here).
_to_delete/

# Build/backup artifacts, not source -- see the node_modules note above,
# same 100MB-push-blocker risk (billion-src.tgz alone is 141MB).
nancy-billion/billion-src.tgz
nancy-billion/backups/

# A full separate clone (has its own .git) vendored for the real NeuTTS
# voice engine -- not this repo's source, and `git add` would either error
# on the nested .git or silently create a submodule reference nobody set up.
neutts/
